# 考研数学智能辅导系统 — 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# .env 已被 .gitignore 排除，不会提交到版本库

# ── 主 LLM API ──
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ── 分 Agent 模型（留空则使用主模型） ──
SOLVER_MODEL=
GRADING_MODEL=
DIAGNOSIS_MODEL=
MEMORY_MODEL=

# ── Vision API（OCR 云 fallback） ──
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o

# ── 规范解题轨迹 ──
CANONICAL_SOLVE_MODEL=
VERIFY_STEPS=true

# ── API Key 轮换周期（天） ──
KEY_ROTATION_DAYS=15
