  "question": "设 $f(x) = |\\ln|x||$，则",
  "options": {
    "A": "$x=1$ 不是 $f(x)$ 的极值点",
    "B": "$(1,0)$ 不是 $y=f(x)$ 的拐点",
    "C": "$x=-1$ 不是 $f(x)$ 的驻点",
    "D": "$x=0$ 不是 $y=f(x)$ 的渐近线"
