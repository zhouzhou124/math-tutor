    "B": "$P\\{\\chi_{1-\\frac{\\alpha}{2}}^2(2n-2) < \\frac{(n-1)W}{\\sigma^2} < \\chi_{\\frac{\\alpha}{2}}^2(2n-2)\\} = 1-\\alpha$",
    "C": "$P\\{-t_{\\frac{\\alpha}{2}}(2n) < \\frac{\\sqrt{n}(\\overline{X}-\\overline{Y})}{W} < t_{\\frac{\\alpha}{2}}(2n)\\} = 1-\\alpha$",
    "D": "$P\\{-t_{\\frac{\\alpha}{2}}(2n-2) < \\frac{\\sqrt{n}(\\overline{X}-\\overline{Y})}{W} < t_{\\frac{\\alpha}{2}}(2n-2)\\} = \\alpha$"
  },
