                  "type": "text",
                  "content": "，"
                },
                {
                  "type": "latex",
                  "content": "\\cos t = \\sqrt{1-x^2}"
                },
                {
                  "type": "text",
                  "content": "，因为 "
                },
                {
                  "type": "latex",
                  "content": "x>0"
                },
                {
                  "type": "text",
                  "content": "，绝对值可去掉：\n"
                },
                {
                  "type": "latex",
                  "content": "y(x) = \\ln\\left( \\frac{1 - \\sqrt{1-x^2}}{x} \\right) + \\sqrt{1-x^2} + C.",
                  "display": "block"
                }
              ]
            },
            {
              "label": "步骤3",
              "blocks": [
                {
                  "type": "text",
                  "content": "利用初始条件确定特解\n代入 "
                },
                {
                  "type": "latex",
                  "content": "y(1)=0"
                },
                {
                  "type": "text",
                  "content": "：\n"
                },
                {
                  "type": "latex",
                  "content": "y(1) = \\ln\\left( \\frac{1 - 0}{1} \\right) + 0 + C = 0 + C = 0 \\quad \\Rightarrow \\quad C = 0.",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "所以特解为\n"
                },
                {
                  "type": "latex",
                  "content": "y(x) = \\ln\\left( \\frac{1 - \\sqrt{1-x^2}}{x} \\right) + \\sqrt{1-x^2}, \\quad x \\in (0,1.)",
                  "display": "block"
                }
              ]
            },
            {
              "label": "步骤4",
              "blocks": [
                {
                  "type": "text",
                  "content": "计算定积分 "
                },
                {
                  "type": "latex",
                  "content": "\\int_0^1 y(x)dx"
                },
                {
                  "type": "text",
                  "content": "（分部积分法简化）\n直接积分较繁琐，利用原方程 "
                },
                {
                  "type": "latex",
                  "content": "xy' = \\sqrt{1-x^2}"
                },
                {
                  "type": "text",
                  "content": " 分部积分：\n"
                },
                {
                  "type": "latex",
                  "content": "\\begin{aligned}\\int_0^1 y(x)dx \n&= \\Big[ x y(x) \\Big]_0^1 - \\int_0^1 x y'(x) dx.\n\\end{aligned}",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "计算边界项：在 "
                },
                {
                  "type": "latex",
                  "content": "x=1"
                },
                {
                  "type": "text",
                  "content": "，"
                },
                {
                  "type": "latex",
                  "content": "y(1)=0"
                },
                {
                  "type": "text",
                  "content": "，故 "
                },
                {
                  "type": "latex",
                  "content": "1 \\cdot y(1) = 0"
                },
                {
                  "type": "text",
                  "content": "。在 "
                },
                {
                  "type": "latex",
                  "content": "x \\to 0^+"
                },
                {
                  "type": "text",
                  "content": "，\n"
                },
                {
                  "type": "latex",
                  "content": "\\lim_{x\\to 0^+} x y(x) = \\lim_{x\\to 0^+} \\left[ x \\ln\\left( \\frac{1 - \\sqrt{1-x^2}}{x} \\right) + x\\sqrt{1-x^2} \\right].",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "当 "
                },
                {
                  "type": "latex",
                  "content": "x\\to 0^+"
                },
                {
                  "type": "text",
                  "content": "，"
                },
                {
                  "type": "latex",
                  "content": "\\sqrt{1-x^2} = 1 - \\frac{x^2}{2} + O(x^4)"
                },
                {
                  "type": "text",
                  "content": "，"
                },
                {
                  "type": "latex",
                  "content": "\\frac{1-\\sqrt{1-x^2}}{x} \\sim \\frac{x}{2}"
                },
                {
                  "type": "text",
                  "content": "，故 "
                },
                {
                  "type": "latex",
                  "content": "x\\ln(\\cdots) \\sim x\\ln x \\to 0"
                },
                {
                  "type": "text",
                  "content": "，且 "
                },
                {
                  "type": "latex",
                  "content": "x\\sqrt{1-x^2}\\to 0"
                },
                {
                  "type": "text",
                  "content": "，所以边界项为 "
                },
                {
                  "type": "latex",
                  "content": "0"
                },
                {
                  "type": "text",
                  "content": "。于是\n"
                },
                {
                  "type": "latex",
                  "content": "\\int_0^1 y(x)dx = - \\int_0^1 x y'(x) dx.",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "代入 "
                },
                {
                  "type": "latex",
                  "content": "y'(x) = \\dfrac{\\sqrt{1-x^2}}{x}"
                },
                {
                  "type": "text",
                  "content": "：\n"
                },
                {
                  "type": "latex",
                  "content": "\\int_0^1 y(x)dx = - \\int_0^1 x \\cdot \\frac{\\sqrt{1-x^2}}{x} dx = - \\int_0^1 \\sqrt{1-x^2}\\, dx.",
                  "display": "block"
                }
              ]
            },
