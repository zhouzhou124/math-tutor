                  "content": "\\begin{aligned}f(x_1,x_2,x_3) &= x_1^2+2x_2^2+2x_3^2+2x_1x_2-2x_1x_3 \\\\&= (x_1+x_2-x_3)^2 - (x_2-x_3)^2 + 2x_2^2+2x_3^2 \\\\\n&= (x_1+x_2-x_3)^2 + (x_2+x_3)^2.\n\\end{aligned}",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "令\n"
                },
                {
                  "type": "latex",
                  "content": "\\begin{cases}z_1 = x_1+x_2-x_3, \\z_2 = x_2+x_3, \\z_3 = x_3,\\end{cases}",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "即 "
                },
                {
                  "type": "latex",
                  "content": "z = C^{-1}x"
                },
                {
                  "type": "text",
                  "content": "，其中 "
                },
                {
                  "type": "latex",
                  "content": "C^{-1} = \\begin{pmatrix} 1 & 1 & -1 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1 \\end{pmatrix}"
                },
                {
                  "type": "text",
                  "content": "，则 "
                },
                {
                  "type": "latex",
                  "content": "x = C z"
                },
                {
                  "type": "text",
                  "content": "，且 "
                },
                {
                  "type": "latex",
                  "content": "f = z_1^2+z_2^2"
                },
                {
                  "type": "text",
                  "content": "。求得 "
                },
                {
                  "type": "latex",
                  "content": "C = (C^{-1})^{-1} = \\begin{pmatrix} 1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 1 \\end{pmatrix}"
                },
                {
                  "type": "text",
                  "content": "。\n\n对 "
                },
                {
                  "type": "latex",
                  "content": "g"
                },
                {
                  "type": "text",
                  "content": " 配方：\n"
                },
                {
                  "type": "latex",
                  "content": "g(y_1,y_2,y_3) = y_1^2 + (y_2+y_3)^2.",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "令\n"
                },
                {
                  "type": "latex",
                  "content": "\\begin{cases}w_1 = y_1, \\w_2 = y_2+y_3, \\w_3 = y_3,\\end{cases}",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "即 "
                },
                {
                  "type": "latex",
                  "content": "w = D^{-1}y"
                },
                {
                  "type": "text",
                  "content": "，其中 "
                },
                {
                  "type": "latex",
                  "content": "D^{-1} = \\begin{pmatrix} 1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1 \\end{pmatrix}"
                },
                {
                  "type": "text",
                  "content": "，则 "
                },
                {
                  "type": "latex",
                  "content": "y = D w"
                },
                {
                  "type": "text",
                  "content": "，且 "
                },
                {
                  "type": "latex",
                  "content": "g = w_1^2+w_2^2"
                },
                {
                  "type": "text",
                  "content": "。\n\n令 "
                },
                {
                  "type": "latex",
                  "content": "z = w"
                },
                {
                  "type": "text",
                  "content": "，则 "
                },
                {
                  "type": "latex",
                  "content": "x = C z = C w = C D^{-1} y"
                },
                {
                  "type": "text",
                  "content": "，于是可逆变换矩阵为\n"
                },
                {
                  "type": "latex",
                  "content": "P = C D^{-1} = \\begin{pmatrix} 1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 1 \\end{pmatrix} \\begin{pmatrix} 1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1 \\end{pmatrix} = \\begin{pmatrix} 1 & -1 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1 \\end{pmatrix}.",
                  "display": "block"
                },
                {
                  "type": "text",
                  "content": "此时 "
                },
                {
                  "type": "latex",
                  "content": "x = P y"
                },
                {
                  "type": "text",
                  "content": " 将 "
                },
                {
                  "type": "latex",
                  "content": "f"
                },
                {
                  "type": "text",
                  "content": " 化为 "
                },
                {
                  "type": "latex",
                  "content": "g"
                },
                {
                  "type": "text",
                  "content": "（"
                },
                {
                  "type": "latex",
                  "content": "P"
                },
                {
                  "type": "text",
                  "content": " 不唯一）。"
                }
              ]
